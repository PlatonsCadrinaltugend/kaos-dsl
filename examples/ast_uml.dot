
digraph KaosUmlProfile {
    rankdir=TB;

    graph [
        splines=true,
        overlap=false,
        nodesep=0.7,
        ranksep=1.0
    ];

    node [shape=plain];
    edge [fontsize=10];

    "goal1" [
        label=
<
<TABLE BORDER="1"
       CELLBORDER="0"
       CELLSPACING="0"
       CELLPADDING="5">
    
<TR>
    <TD>&lt;&lt;goal&gt;&gt;</TD>
</TR>

    <TR>
        <TD><B>goal1</B></TD>
    </TR>
    
<TR>
    <TD ALIGN="LEFT">{name = goal}</TD>
</TR>

</TABLE>
>

    ];

}
