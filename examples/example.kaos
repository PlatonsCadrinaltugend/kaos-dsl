goal ImproveHealth {
    informalDef = "Users shall improve their long-term health"
}

goal ProvidePersonalizedRecommendations {
    informalDef = "Users shall receive personalized health recommendations"
}

requirement GenerateRecommendations {
    informalDef = "The system shall generate personalized health recommendations"
}

object HealthData
object HealthRecommendation

action GenerateHealthRecommendation

agent HealthAdvisor {
    realm = "software"
}

GenerateRecommendations reduces ProvidePersonalizedRecommendations
ProvidePersonalizedRecommendations reduces ImproveHealth

GenerateHealthRecommendation operationalizes GenerateRecommendations

HealthAdvisor is responsible for GenerateRecommendations
HealthAdvisor performs GenerateHealthRecommendation

GenerateHealthRecommendation has input HealthData
GenerateHealthRecommendation has output HealthRecommendation

ProvidePersonalizedRecommendations concerns HealthRecommendation
